# Backend - Projeto Fitness
# Copie para .env e preencha os valores

# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@host:porta/database"

# JWT Secret (mínimo 32 caracteres)
JWT_SECRET="chave_secreta_super_secreta_do_fitness_app_2025"

# Node Environment
NODE_ENV="production"

# Server Port (Railway define automaticamente, mas pode especificar)
PORT=3001
